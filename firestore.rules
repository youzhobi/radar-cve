// ============================================================
//  firestore.rules
//  ============================================================
//  Este arquivo diz ao Firestore QUEM pode ler e QUEM pode
//  escrever nos seus dados. Sem essas regras, por padrão o
//  Firestore bloqueia TUDO (nem leitura, nem escrita).
//
//  Nesse projeto:
//    - allow read: if true   -> qualquer visitante do site pode
//                                LER os dados (é um painel público)
//    - allow write: if false -> NINGUÉM pode escrever direto pelo
//                                site. Só o script Python (que usa
//                                a "chave secreta" do Admin SDK)
//                                consegue escrever, porque o Admin
//                                SDK ignora essas regras de propósito
//                                (ele já é o "dono" do banco).
//
//  Isso é o que protege seus dados de vandalismo mesmo com o
//  código do app.js e a configuração do Firebase sendo públicos.
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
